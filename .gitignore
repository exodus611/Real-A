# --- Ключи и учётные данные ---
# Деплой-ключ лежит здесь и в репозиторий не попадает никогда.
# Каталог .git/ исключать не нужно — git не отслеживает сам себя.
.deploy/
*.pem
*.key
id_rsa*
id_ed25519*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Возобновляемые кэши адресного слоя ---
# geo_<код>.json — это кэш «гуш/хелька → улица», он добирается по одному участку
# за запрос и возобновляется с места остановки. settlements.json — справочник кодов
# населённых пунктов, живёт 14 дней и перетягивается сам.
# Всё это пересобирается, поэтому в репозитории не хранится.
analysis/geo_[0-9]*.json
analysis/settlements.json

# --- Состояние расписания Telegram ---
# last_digest.json хранит дату последней отправки. Это локальное состояние,
# а не часть проекта: в чужом окружении оно должно начаться с нуля.
last_digest.json

# --- Рабочие каталоги сторожа датасетов ---
# snapshots/ — снимки датасетов для сравнения, reports/ — журналы срабатываний.
# Растут бесконечно и зависят от того, когда именно запускали сторож.
snapshots/
reports/

# --- Служебное ---
*.log
.DS_Store
